<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Gibbed.TombRaider.DRMEdit.App"
             xmlns:local="using:Gibbed.TombRaider.DRMEdit"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!-- AvaloniaHex's own Fluent Dark theme (Themes/Fluent/AvaloniaHex.axaml, included below)
         hardcodes PrimaryCaretBackground/SecondaryCaretBackground/PrimaryCaretBorder/
         SecondaryCaretBorder to Magenta/DarkMagenta, unlike PrimarySelectionBackground/
         SecondarySelectionBackground a few keys over, which already derive from
         SystemAccentColor. That reads fine on Windows, where Magenta happens to sit close to
         the default purple accent, but clashes badly against macOS's blue accent. Overridden
         here (checked before Application.Styles content during DynamicResource lookup, so
         this reliably wins over the StyleInclude'd AvaloniaHex theme regardless of include
         order) using SystemAccentColorLight1/2, Avalonia's own Fluent-theme-provided,
         HSL-lightness-shifted shades of whatever SystemAccentColor currently is
         (Avalonia.Themes.Fluent.Accents.SystemAccentColors), so the hex viewer's caret now
         tracks the OS accent color on every platform instead of a fixed hue. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PrimaryCaretBackground" Color="{DynamicResource SystemAccentColorLight2}" Opacity="0.3" />
                    <SolidColorBrush x:Key="SecondaryCaretBackground" Color="{DynamicResource SystemAccentColorLight1}" Opacity="0.5" />
                    <SolidColorBrush x:Key="PrimaryCaretBorderBrush" Color="{DynamicResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="SecondaryCaretBorderBrush" Color="{DynamicResource SystemAccentColorLight1}" />
                    <Pen x:Key="PrimaryCaretBorder" Brush="{DynamicResource PrimaryCaretBorderBrush}" />
                    <Pen x:Key="SecondaryCaretBorder" Brush="{DynamicResource SecondaryCaretBorderBrush}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <materialIcons:MaterialIconStyles />
        <!-- AvaloniaHex ships its own control theme as a separate resource that has to be
             explicitly included (same pattern as materialIcons:MaterialIconStyles above).
             Without it, HexEditor has no control template at all, so it renders nothing
             regardless of Document or Columns being set correctly. -->
        <StyleInclude Source="avares://AvaloniaHex/Themes/Fluent/AvaloniaHex.axaml" />

        <!-- Shared 3-state background treatment for icon-only toolbar buttons: no
             noticeable fill at rest, the theme's normal hover fill on hover, and (while the
             mouse is actually held down) the theme's normal AT-REST fill, not its own
             pressed fill, per explicit design choice. ButtonBackground/
             ButtonBackgroundPointerOver are Avalonia's own FluentTheme semantic resource
             keys (theme/light-dark aware), reused rather than hardcoding hex so these
             buttons stay in sync with whatever the rest of the app's chrome resolves to.
             Padding="6" is explicit (not the FluentTheme default, which is wider than tall)
             so a button is a perfect square around its fixed 18x18 icon: this is the value
             to tune for overall toolbar button size. CornerRadius="4" matches the rounding
             applied to the File/Windows menu headers in MainWindow.axaml. -->
        <Style Selector="Button.toolbarIcon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.toolbarIcon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
        </Style>
        <Style Selector="Button.toolbarIcon:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
        </Style>
        <Style Selector="ToggleButton.toolbarIcon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ToggleButton.toolbarIcon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
        </Style>
        <Style Selector="ToggleButton.toolbarIcon:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
        </Style>
    </Application.Styles>

</Application>
