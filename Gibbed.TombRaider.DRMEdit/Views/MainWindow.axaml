<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Gibbed.TombRaider.DRMEdit.ViewModels"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:local="using:Gibbed.TombRaider.DRMEdit"
        xmlns:converters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
        x:Class="Gibbed.TombRaider.DRMEdit.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1100" Height="750"
        Background="Transparent"
        TransparencyLevelHint="Mica,AcrylicBlur,Blur,None"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="40"
        Title="Tomb Raider DRM Editor">

    <Window.Styles>
        <!-- Pop-out/close buttons: hidden unless their tab is hovered or selected. -->
        <Style Selector="ListBoxItem:not(:pointerover):not(:selected) Button.tabPopOut">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBoxItem:not(:pointerover):not(:selected) Button.tabClose">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Tab title text: default state fills the tab; hover/selected states leave room
             for the overlaid pop-out/close buttons and fade the text out underneath them
             instead of the buttons pushing the tab wider. The mask is set on the wrapping
             Border, not the TextBlock itself: Avalonia positions OpacityMask's relative
             coordinates against a TextBlock's own ink/content bounds (which shrink to the
             actual glyph run) rather than its stretched layout bounds, so short titles were
             getting a narrower mask than long ones. A Border's Bounds are unambiguously its
             full layout box regardless of its child's content length. -->
        <Style Selector="ListBoxItem:not(:pointerover):not(:selected) Border.tabTitle">
            <Setter Property="Margin" Value="10,0,10,0" />
            <Setter Property="OpacityMask" Value="{x:Null}" />
        </Style>
        <!-- The mask brush itself is built per-tab in MainWindow.RecomputeTabWidths from
             fixed pixel constants (TabFadeKeepOutWidth/TabFadeWidth) so it covers the same
             absolute pixel span regardless of tab width, and bound here as one object. -->
        <Style Selector="ListBoxItem:pointerover Border.tabTitle" x:DataType="vm:DocumentTabViewModel">
            <Setter Property="Margin" Value="10,0,44,0" />
            <Setter Property="OpacityMask" Value="{Binding TitleFadeMask}" />
        </Style>
        <Style Selector="ListBoxItem:selected Border.tabTitle" x:DataType="vm:DocumentTabViewModel">
            <Setter Property="Margin" Value="10,0,44,0" />
            <Setter Property="OpacityMask" Value="{Binding TitleFadeMask}" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- Title bar row: a draggable background layer, with title/tabs/window-controls
             layered on top and given no background of their own, so empty space in any of
             them passes the click through to the drag layer instead of swallowing it. -->
        <Grid DockPanel.Dock="Top" Height="40">
            <Border Name="TitleBarDragLayer" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />

            <!-- Column layout defaults to the Windows/Linux arrangement (title, then tabs,
                 then window controls at the far right). MainWindow.axaml.cs repositions
                 this for macOS at construction time: window controls move to Column 0 and
                 the ColumnDefinitions themselves change shape (see
                 RepositionForMacWindowControls), since macOS puts its traffic-light
                 controls at the top-left, not the top-right. -->
            <Grid Name="TitleBarLayoutGrid" ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Name="TitleText" Text="{Binding $parent[Window].Title}"
                           VerticalAlignment="Center" Margin="12,0,16,0" IsHitTestVisible="False" />

                <!-- Fills the whole * column (stable width, independent of tab content) so
                     tab-width calculations in code-behind have a reliable available-width
                     source; the ScrollViewer inside is Left-aligned and only as wide as its
                     content, so genuine empty Grid space (nothing painted, nothing captured)
                     exists beyond the tabs and falls through to the drag layer behind. -->
                <Grid Grid.Column="1" Name="TabsHostGrid">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  Name="TabScrollViewer" Background="{x:Null}" HorizontalAlignment="Left">
                        <ListBox Name="TabListBox"
                                 ItemsSource="{Binding OpenDocuments}"
                                 SelectedItem="{Binding SelectedDocument}"
                                 Background="{x:Null}"
                                 BorderThickness="0"
                                 Padding="4,0"
                                 ScrollViewer.BringIntoViewOnFocusChange="False">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="2,4,0,0" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="CornerRadius" Value="6,6,0,0" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource SystemControlPageBackgroundChromeLowBrush}" />
                                </Style>
                                <Style Selector="ListBoxItem:not(:selected) /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:DocumentTabViewModel">
                                    <Grid Width="{Binding Width}" ToolTip.Tip="{Binding Title}">
                                        <!-- Background="Transparent" (not unset/null) is required: an
                                             unfilled element appears to have no "painted bounds" of its
                                             own for OpacityMask's relative-coordinate purposes, causing
                                             it to fall back to the child TextBlock's actual ink bounds
                                             instead of this Border's full layout box: the same
                                             null-vs-Transparent distinction already relied on elsewhere
                                             in this file for hit-testing pass-through. -->
                                        <Border Classes="tabTitle" Background="Transparent">
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Margin="0,0,4,0">
                                            <Button Command="{Binding PopOutCommand}" Classes="tabPopOut"
                                                    Background="Transparent" BorderThickness="0" Padding="4"
                                                    ToolTip.Tip="Pop out into its own window">
                                                <materialIcons:MaterialIcon Kind="Export" Width="14" Height="14" />
                                            </Button>
                                            <Button Command="{Binding CloseCommand}" Classes="tabClose"
                                                    Background="Transparent" BorderThickness="0" Padding="4"
                                                    ToolTip.Tip="Close">
                                                <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" Name="WindowControlsHost"
                            Margin="8,0,0,0" />
            </Grid>
        </Grid>

        <!-- Toolbar row: File/Windows pinned at the far left, Open DRM + dynamic per-tab
             buttons centered across the FULL row width (not just the space remaining after
             the menu), EXCEPT when the window is narrow enough that centering would push
             the button group left of the menu's own footprint: MainWindow.axaml.cs clamps
             ToolbarButtonsPanel's Margin.Left in that case (see RecomputeToolbarButtonsLeft
             and ToolbarMenuButtonGap). HorizontalAlignment="Left" (not Center) on the
             StackPanel is deliberate: with Margin.Left computed and applied entirely in
             code-behind, Center alignment would additionally center within whatever space
             remains after that margin, double-applying the offset. FontSize="13" on the
             Menu and CornerRadius="4" on the two top-level MenuItems below are the two
             values to tune if the menu still looks too large/square-cornered relative to
             the icon buttons. -->
        <Grid DockPanel.Dock="Top" Name="ToolbarRootGrid" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Menu Name="ToolbarMenu" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="6,0,0,2" FontSize="13">
                <MenuItem Header="_File" CornerRadius="4" Margin="0,0,3,0">
                    <MenuItem Name="OpenMenuItem" Header="_Open" Command="{Binding OpenCommand}">
                        <MenuItem.Icon>
                            <materialIcons:MaterialIcon Kind="FolderFileOutline" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="E_xit" Click="OnExitClick" />
                </MenuItem>
                <MenuItem Header="_Windows" CornerRadius="4">
                    <MenuItem Header="C_lose All" Command="{Binding CloseAllCommand}" />
                </MenuItem>
            </Menu>

            <StackPanel Name="ToolbarButtonsPanel" Orientation="Horizontal" Spacing="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="0,0,0,2">
                <!-- Shows "Open DRM" text next to the icon whenever no tab is currently
                     selected: i.e. whenever the app is showing its blank landing page,
                     which happens both before any file is ever opened AND every time the
                     last/only remaining tab is closed (this app has no other way to get
                     back to that landing page, so SelectedDocument == null is exactly and
                     only that state). Binding directly to SelectedDocument's nullity (via
                     the built-in ObjectConverters.IsNull, no ViewModel-side flag) is
                     deliberately simpler than tracking OpenDocuments.Count: a
                     HasOpenDocuments-style flag would stay true (hiding the text) whenever
                     ANY tab was still open in the list even if the user wasn't actually
                     looking at one, which is exactly the mismatch that made the landing page
                     show an icon-only button with nothing else on screen to open a file from. -->
                <Button Name="OpenDrmButton" Classes="toolbarIcon" Command="{Binding OpenCommand}" ToolTip.Tip="Open DRM">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="FolderFileOutline" Width="18" Height="18" />
                        <!-- FontSize="13" matches ToolbarMenu's own FontSize below (its two
                             values are meant to stay in sync); FontFamily is left unset on
                             both, so it already inherits the same app-wide default. -->
                        <TextBlock Text="Open DRM" VerticalAlignment="Center" FontSize="13"
                                   IsVisible="{Binding SelectedDocument, Converter={x:Static converters:ObjectConverters.IsNull}}" />
                    </StackPanel>
                </Button>
                <ContentControl Content="{Binding SelectedDocument}">
                    <ContentControl.ContentTemplate>
                        <local:ToolbarViewLocator />
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <ContentControl Content="{Binding SelectedDocument}" Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}" />

    </DockPanel>

</Window>
