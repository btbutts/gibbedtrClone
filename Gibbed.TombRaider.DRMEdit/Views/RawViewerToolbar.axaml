<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gibbed.TombRaider.DRMEdit.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Gibbed.TombRaider.DRMEdit.Views.RawViewerToolbar"
             x:DataType="vm:RawViewerViewModel">
    <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Classes="toolbarIcon" Command="{Binding LoadFromFileCommand}" ToolTip.Tip="Load from file">
            <materialIcons:MaterialIcon Kind="FileImportOutline" Width="18" Height="18" />
        </Button>
        <Button Classes="toolbarIcon" Command="{Binding SaveToFileCommand}" ToolTip.Tip="Save to file">
            <materialIcons:MaterialIcon Kind="ContentSaveAllOutline" Width="18" Height="18" />
        </Button>
    </StackPanel>
</UserControl>
