<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gibbed.DeusEx3.DRMEdit.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Gibbed.DeusEx3.DRMEdit.Views.FileViewerToolbar"
             x:DataType="vm:FileViewerViewModel">
    <StackPanel Orientation="Horizontal" Spacing="0">
        <!-- No command: Gibbed.DeusEx3.FileFormats.DRMFile has no Serialize() method, so
             there's no equivalent to TR's SaveDrmCommand at all. Kept as a permanently
             disabled icon (rather than removed) for visual parity with Tomb Raider's
             toolbar, matching the original WinForms saveDRMButton's Enabled=false. -->
        <Button Classes="toolbarIcon" IsEnabled="False" ToolTip.Tip="Not supported for Deus Ex 3 DRM files">
            <materialIcons:MaterialIcon Kind="FileExportOutline" Width="18" Height="18" />
        </Button>
        <ComboBox ItemsSource="{Binding TypeFilterOptions}" SelectedItem="{Binding SelectedTypeFilter}" Width="140" />
        <Button Classes="toolbarIcon" Command="{Binding ViewSectionCommand}" ToolTip.Tip="View section">
            <materialIcons:MaterialIcon Kind="OpenInApp" Width="18" Height="18" />
        </Button>
        <!-- Padding="4" overrides Button.toolbarIcon's Padding="6" (inline Setter beats a
             Style setter of equal specificity) for this button only: the Hexadecimal glyph
             is visually just a small "0x", so at the standard 18x18/Padding=6 it reads as
             noticeably smaller than every other toolbar icon despite being the same nominal
             size. Bumping the icon to 22x22 while trimming padding to 4 keeps the button's
             own total footprint identical (4+22+4 = 6+18+6 = 30), so it still lines up
             flush with its neighbors. -->
        <Button Classes="toolbarIcon" Padding="4" Command="{Binding ViewSectionRawCommand}" ToolTip.Tip="View section raw">
            <materialIcons:MaterialIcon Kind="Hexadecimal" Width="22" Height="22" />
        </Button>
    </StackPanel>
</UserControl>
