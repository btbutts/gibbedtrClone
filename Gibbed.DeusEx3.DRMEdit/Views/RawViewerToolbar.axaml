<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Gibbed.DeusEx3.DRMEdit.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Gibbed.DeusEx3.DRMEdit.Views.RawViewerToolbar"
             x:DataType="vm:RawViewerViewModel">
    <StackPanel Orientation="Horizontal" Spacing="0">
        <!-- LoadFromFileCommand's CanExecute is permanently false (matches the original
             WinForms RawViewer's loadFromFileButton, which was Enabled=false and never
             enabled anywhere); the command binding alone renders this correctly disabled. -->
        <Button Classes="toolbarIcon" Command="{Binding LoadFromFileCommand}" ToolTip.Tip="Load from file">
            <materialIcons:MaterialIcon Kind="FileImportOutline" Width="18" Height="18" />
        </Button>
        <Button Classes="toolbarIcon" Command="{Binding SaveToFileCommand}" ToolTip.Tip="Save to file">
            <materialIcons:MaterialIcon Kind="ContentSaveAllOutline" Width="18" Height="18" />
        </Button>
        <ToggleButton Classes="toolbarIcon" IsChecked="{Binding SpanWindowWidth}" ToolTip.Tip="Span window width">
            <materialIcons:MaterialIcon Kind="ArrowExpandHorizontal" Width="18" Height="18" />
        </ToggleButton>
    </StackPanel>
</UserControl>
