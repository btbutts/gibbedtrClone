<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Gibbed.DeusEx3.DRMEdit.ViewModels"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:local="using:Gibbed.DeusEx3.DRMEdit"
        x:Class="Gibbed.DeusEx3.DRMEdit.Views.PopOutWindow"
        x:DataType="vm:DocumentTabViewModel"
        Width="700" Height="500"
        Background="Transparent"
        TransparencyLevelHint="Mica,AcrylicBlur,Blur,None"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="40"
        Title="{Binding Title}">

    <DockPanel>

        <!-- Title bar row: draggable background layer behind title text and window
             controls, matching MainWindow's pattern (see MainWindow.axaml). -->
        <Grid DockPanel.Dock="Top" Height="40">
            <Border Name="TitleBarDragLayer" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />

            <Grid Name="TitleBarContentGrid" ColumnDefinitions="*,Auto">
                <TextBlock Name="TitleText" Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center"
                           Margin="12,0,16,0" IsHitTestVisible="False" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch" Name="WindowControlsHost" />
            </Grid>
        </Grid>

        <Grid DockPanel.Dock="Top" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <!-- HorizontalAlignment="Center": a StackPanel left as the default Stretch
                 still arranges its own children starting from its own left edge, it
                 doesn't center them within the extra stretched space. MainWindow centers
                 its toolbar group via computed-margin code-behind (RecomputeToolbarButtonsLeft)
                 because it also has a File/Windows menu the group must not overlap; this
                 window has no menu to avoid, so plain centering is sufficient. -->
            <StackPanel Orientation="Horizontal" Spacing="0" Margin="6,0,6,2" HorizontalAlignment="Center">
                <Button Classes="toolbarIcon" Command="{Binding PopInCommand}" ToolTip.Tip="Dock back into main window">
                    <materialIcons:MaterialIcon Kind="DockWindow" Width="18" Height="18" />
                </Button>
                <ContentControl Content="{Binding}">
                    <ContentControl.ContentTemplate>
                        <local:ToolbarViewLocator />
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </StackPanel>
        </Grid>

        <ContentControl Content="{Binding}" Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}" />
    </DockPanel>

</Window>
