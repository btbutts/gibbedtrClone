<Project>

  <!-- Shared by every project under the repo root: enables building/publishing each
       tool for Windows or macOS (Apple Silicon or Intel), and routes both the final
       output and the intermediate (obj) files into a per-platform subfolder underneath
       whatever OutputPath the project already sets, so a plain right-click Build in
       Visual Studio and a "dotnet build -r osx-arm64" from the command line never
       collide in the same directory. Win32/win-x86 isn't wired up as an active
       RuntimeIdentifier today (nothing in this repo builds it), but the folder name is
       reserved below so adding it later is a one-line change. -->

  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- A plain "dotnet build"/"dotnet run" with no explicit -r leaves RuntimeIdentifier
       empty. This used to map straight to Win64 unconditionally below, so on macOS every
       ordinary no-RID build (the everyday command line workflow, not just
       CrystalDynamics.Builder's explicit per-platform passes) wrote its obj/output into a
       folder literally named Win64, sharing that path's cached NuGet/Roslyn state with an
       actual win-x64 cross-compile pass and corrupting later incremental builds until the
       whole obj tree had to be wiped and the repo re-cloned to recover. Confirmed via a
       throwaway diagnostic Target run directly on the Mac hardware: RuntimeIdentifier=[],
       PlatformOutputFolder=[Win64] regardless.

       NETCoreSdkRuntimeIdentifier (the SDK's own RID for the current machine) looked like
       the obvious fallback, but a separate throwaway probe proved it reads back empty this
       early: Directory.Build.props imports before the SDK sets it, the same timing trap
       the IntermediateOutputPath comment below already documents for
       BaseIntermediateOutputPath. $(OS), $([MSBuild]::IsOSPlatform(...)), and
       $([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture) are true
       MSBuild/CLR intrinsics rather than SDK-injected properties, confirmed available at
       this same early point, so those are what actually detect the host here. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <EffectiveRuntimeIdentifier>$(RuntimeIdentifier)</EffectiveRuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' And '$([MSBuild]::IsOSPlatform(`Windows`))' == 'true'">
    <EffectiveRuntimeIdentifier>win-x64</EffectiveRuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' And '$([MSBuild]::IsOSPlatform(`OSX`))' == 'true' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'">
    <EffectiveRuntimeIdentifier>osx-arm64</EffectiveRuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' And '$([MSBuild]::IsOSPlatform(`OSX`))' == 'true' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' != 'Arm64'">
    <EffectiveRuntimeIdentifier>osx-x64</EffectiveRuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(EffectiveRuntimeIdentifier)' == 'win-x64' ">
    <PlatformOutputFolder>Win64</PlatformOutputFolder>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(EffectiveRuntimeIdentifier)' == 'win-x86' ">
    <PlatformOutputFolder>Win32</PlatformOutputFolder>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(EffectiveRuntimeIdentifier)' == 'osx-arm64' ">
    <PlatformOutputFolder>MacOS-arm64</PlatformOutputFolder>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(EffectiveRuntimeIdentifier)' == 'osx-x64' ">
    <PlatformOutputFolder>MacOS-Intel</PlatformOutputFolder>
  </PropertyGroup>

  <!-- Gives every platform, including the default/no-RID Win64 build, its own named
       obj subfolder. Without this, only an explicit-RID build gets nested under obj\
       (e.g. obj\Debug\osx-arm64\) while the default build writes straight into
       obj\Debug\ with nothing underneath - fine for correctness (the SDK already keeps
       RID-specific intermediates apart on its own), but inconsistent to look at.
       Hardcoded "obj\" rather than $(BaseIntermediateOutputPath): Directory.Build.props
       is imported before the SDK assigns that property its default value, so reading
       it here evaluates empty and silently drops the "obj\" segment, which puts the
       generated AssemblyAttributes.cs outside the SDK's default obj/** exclude glob
       and makes it compile twice (CS0579). Safe to hardcode: nothing in this repo
       overrides BaseIntermediateOutputPath. -->
  <PropertyGroup Condition="'$(PlatformOutputFolder)' != ''">
    <IntermediateOutputPath>obj\$(Configuration)\$(PlatformOutputFolder)\</IntermediateOutputPath>
  </PropertyGroup>

</Project>
