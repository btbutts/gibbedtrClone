<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mono.Options</RootNamespace>
    <AssemblyName>Mono.Options</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Options.cs is vendored unmodified from upstream mono/mono; its legacy
         ISerializable support on OptionException predates these APIs being
         marked obsolete. Suppressed here rather than editing vendored source. -->
    <NoWarn>$(NoWarn);SYSLIB0003;SYSLIB0051;CS0672</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>..\bin_tr\$(PlatformOutputFolder)\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>..\bin_tr_release\$(PlatformOutputFolder)\</OutputPath>
  </PropertyGroup>

</Project>
