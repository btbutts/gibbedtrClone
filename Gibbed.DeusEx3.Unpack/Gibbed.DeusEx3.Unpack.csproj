<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Gibbed.DeusEx3.Unpack</RootNamespace>
    <AssemblyName>Gibbed.DeusEx3.Unpack</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>..\bin_dx3\$(PlatformOutputFolder)\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>..\bin_dx3_release\$(PlatformOutputFolder)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gibbed.CrystalDynamics.FileFormats\Gibbed.CrystalDynamics.FileFormats.csproj" />
    <ProjectReference Include="..\Gibbed.DeusEx3.FileFormats\Gibbed.DeusEx3.FileFormats.csproj" />
    <ProjectReference Include="..\Gibbed.IO\Gibbed.IO.csproj" />
    <ProjectReference Include="..\Gibbed.ProjectData\Gibbed.ProjectData.csproj" />
    <ProjectReference Include="..\Mono.Options\Mono.Options.csproj" />
  </ItemGroup>

  <Target Name="CopyProjectsData" BeforeTargets="Build">
    <!-- Copied once to bin_dx3\projects (or bin_dx3_release\projects), a sibling of
         Win64\MacOS-arm64\MacOS-Intel rather than duplicated inside each of them -
         Gibbed.ProjectData looks one directory up from the running executable for
         this folder for exactly that reason (see Manager.cs). SkipUnchangedFiles
         makes the redundant copy from each platform's own build a cheap no-op. -->
    <ItemGroup>
      <ProjectsDataFile Include="..\projects\DX3\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ProjectsDataFile)"
          DestinationFiles="@(ProjectsDataFile->'$(OutputPath)..\projects\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
